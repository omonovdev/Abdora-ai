# Serverdagi .env.production uchun namuna. Haqiqiy qiymatlar faqat serverda turadi.
NODE_ENV=production
PORT=5000

# Local Postgres container (docker-compose DATABASE_URL ni shu qiymatlardan yasaydi)
POSTGRES_USER=abdora
POSTGRES_PASSWORD=
POSTGRES_DB=abdora

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

GIMINI_AI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

CLIENT_URL=https://abdoraai.uz
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads/

# Bir xil originda xizmat qilinadi, shuning uchun nisbiy yo'l
VITE_API_URL=/api
